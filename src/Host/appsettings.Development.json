{
  "Logging": {
  "LogLevel": {
    "Default": "Information",
    "Microsoft.AspNetCore": "Warning",
    "System.Net.Http.HttpClient": "Warning",
    "Wolverine": "Warning"
  },
  "Console": {
    "FormatterName": "simple",
    "FormatterOptions": {
      "SingleLine": true,
      "TimestampFormat": "HH:mm:ss "
    }
  }
},
  "Embedding": {
    "Url": "http://localhost:11434",
    "Model": "bge-m3-cpu",
    "Dimensions": 1024,
    "BatchSize": 8
  },
  "Database": {
    "DefaultConnection": "Host=localhost;Port=5433;Username=admin;Password=admin;Database=lawsearch"
  },
  "Chat": {
    "Endpoint": "https://opencode.ai/inference/openai/v1",
    "Model": "glm-5.3-flash"
  },
  "Ingestion": {
    "DocumentsFolder": "../../data"
  },
  "Query": {
    "TopK": 6,
    "RerankCandidates": 10,
    "VectorCandidates": 20,
    "KeywordCandidates": 20,
    "RrfK": 60,
    "VectorWeight": 1.0,
    "KeywordWeight": 0.5,
    "Temperature": 0,
    "HistoryLength": 4
  },
  "Rerank": {
    "Url": "http://localhost:8081",
    "TimeoutSeconds": 90,
    "BatchSize": 32
  }
}