    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="OllamaSharp" Version="5.5.0" />
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <PackageVersion Include="WolverineFx" Version="6.51.2" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.51.2" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.51.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>